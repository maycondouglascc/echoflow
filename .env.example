# Add only the variables required by the feature being implemented.
# Public values are still subject to Supabase RLS and authorization checks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# PostHog browser analytics (public project configuration).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional source-map upload credentials, used only at build time.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Only local import/test maintenance uses service role. The application never uses it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional offline audio-generation tooling, not required to run the platform.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# Isolated feedback worker ONLY. Use .env.notion-worker.local or server secrets,
# never the Next.js/Vercel environment. Run scripts/setup-notion-feedback.sh.
ECHOFLOW_FEEDBACK_SUPABASE_URL=
ECHOFLOW_FEEDBACK_SERVICE_ROLE_KEY=
NOTION_FEEDBACK_TOKEN=
NOTION_FEEDBACK_DATA_SOURCE_ID=173fea48-0b42-40cc-996f-14c762857aa1
