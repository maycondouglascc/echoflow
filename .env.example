# Add only the variables required by the feature being implemented.
# Public values are still subject to Supabase RLS and authorization checks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Only local import/test maintenance uses service role. The application never uses it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional offline audio-generation tooling, not required to run the platform.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
