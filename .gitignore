# Dependencies and package-manager state
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js output
/.next/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# Local environment and credentials
.env
.env.*
!.env.example
*.pem

# Local agent state; keep only the project Spec Kit skills
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/speckit-*/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/speckit-*/

# Spec Kit machine-local feature and extension state is ignored in .specify/.gitignore
.vercel/
coverage/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
playwright-report/
test-results/
