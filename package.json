{
  "name": "echoflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src tests playwright.config.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "catalog:seed": "node scripts/generate-catalog-seed.mjs",
    "audio:import": "node --env-file=.env.local scripts/import-reference-audio.ts",
    "audio:generate": "python3 scripts/generate-openrouter-audio.py",
    "test:audio-generator": "python3 -m unittest discover -s tests/python -p 'test_*.py'",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "html-to-image": "1.11.13",
    "motion": "13.4.4",
    "posthog-js": "1.438.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@posthog/nextjs-config": "1.11.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.29",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
